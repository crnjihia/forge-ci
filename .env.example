# ==============================================================================
# Forge CI - Environment Configuration Template
# ==============================================================================

# Server Runtime
PORT=8080
ENV=development
TIMEZONE=Africa/Nairobi

# Encryption Master Key (AES-256-GCM - exactly 32 bytes ASCII or base64 decoded)
# Example 32-byte ASCII key: "0123456789abcdef0123456789abcdef"
FORGE_MASTER_KEY=0123456789abcdef0123456789abcdef

# Database & Cache
POSTGRES_URL=postgres://forge:forge_secret@localhost:5432/forge_ci?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# MinIO (S3-Compatible Artifact Storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=forge_minio_admin
MINIO_SECRET_KEY=forge_minio_secret
MINIO_BUCKET=forge-artifacts
MINIO_USE_SSL=false

# GitHub Webhook Integration
GITHUB_WEBHOOK_SECRET=sample_github_webhook_secret_32_bytes_long
GITHUB_TOKEN=ghp_mock_token_for_status_reporting

# Global Mock Flag for External APIs (Set to true to run fully offline without credentials)
USE_MOCK_INTEGRATIONS=true

# Safaricom Daraja M-Pesa Integration (Sandbox)
MPESA_CONSUMER_KEY=daraja_sandbox_consumer_key
MPESA_CONSUMER_SECRET=daraja_sandbox_consumer_secret
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_SHORTCODE=174379
MPESA_CALLBACK_URL=http://localhost:8080/api/v1/billing/mpesa/callback

# Africa's Talking SMS Alerts (Sandbox)
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=at_sandbox_synthetic_api_key_for_testing
AFRICASTALKING_SENDER_ID=FORGECI


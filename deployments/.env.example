# path: deployments/.env.example
# ==============================================================================
# Forge CI - Production Environment Configuration Template
# Copy this file to .env (or /etc/forge/forge.env) and populate secrets.
# ==============================================================================

# Server Environment & Localization
ENV=production
PORT=8080
TIMEZONE=Africa/Nairobi
LOG_LEVEL=info
DOMAIN=ci.example.co.ke

# Master Encryption Key (Must be 32 bytes / 64 hex chars for AES-256-GCM secrets vault)
# Generate via: openssl rand -hex 32
FORGE_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# PostgreSQL 16 Primary Database
POSTGRES_USER=forge_admin
POSTGRES_PASSWORD=replace_with_strong_pg_password
POSTGRES_DB=forge_ci
POSTGRES_URL=postgres://forge_admin:replace_with_strong_pg_password@postgres:5432/forge_ci?sslmode=disable

# Redis 7 Pub/Sub & Ephemeral State
REDIS_PASSWORD=replace_with_strong_redis_password
REDIS_URL=redis://:replace_with_strong_redis_password@redis:6379/0

# MinIO / S3 Object Storage for Pipeline Artifacts
MINIO_ROOT_USER=forge_minio_admin
MINIO_ROOT_PASSWORD=replace_with_strong_minio_password
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=forge_minio_admin
MINIO_SECRET_KEY=replace_with_strong_minio_password
MINIO_BUCKET=forge-artifacts
MINIO_USE_SSL=false

# Production Integrations Toggle (set false for real Daraja/AT/GitHub calls)
USE_MOCK_INTEGRATIONS=false

# Safaricom Daraja M-Pesa API Credentials (STK Push billing)
DARAJA_ENVIRONMENT=sandbox # sandbox or production
DARAJA_CONSUMER_KEY=your_daraja_consumer_key
DARAJA_CONSUMER_SECRET=your_daraja_consumer_secret
DARAJA_BUSINESS_SHORTCODE=174379
DARAJA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
DARAJA_CALLBACK_URL=https://ci.example.co.ke/billing/mpesa/callback

# Africa's Talking SMS API (Real-time build alerts)
AT_USERNAME=sandbox
AT_API_KEY=your_africas_talking_api_key
AT_SENDER_ID=FORGE_CI

# GitHub Integration
GITHUB_TOKEN=ghp_yourPersonalAccessTokenOrGitHubAppToken
GITHUB_WEBHOOK_SECRET=your_github_webhook_hmac_secret


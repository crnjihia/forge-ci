# path: deployments/systemd/forge.env
# ==============================================================================
# Forge CI - Systemd Environment Configuration
# Installed to: /etc/forge/forge.env (chmod 0600, chown forge:forge)
# ==============================================================================

# Core Service Configuration
ENV=production
PORT=8080
TIMEZONE=Africa/Nairobi
LOG_LEVEL=info

# Master Encryption Key (32 bytes / 64 hex characters for AES-256-GCM vault)
# Generate via: openssl rand -hex 32
FORGE_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# PostgreSQL Connection
POSTGRES_URL=postgres://forge_admin:replace_password@localhost:5432/forge_ci?sslmode=disable

# Redis Connection
REDIS_URL=redis://:replace_password@localhost:6379/0

# MinIO / S3 Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=forge_minio_admin
MINIO_SECRET_KEY=replace_minio_secret
MINIO_BUCKET=forge-artifacts
MINIO_USE_SSL=false

# Mocks (set false for real Daraja, Africa's Talking, and GitHub webhooks)
USE_MOCK_INTEGRATIONS=false

# Safaricom Daraja M-Pesa STK Push
DARAJA_ENVIRONMENT=sandbox
DARAJA_CONSUMER_KEY=replace_daraja_key
DARAJA_CONSUMER_SECRET=replace_daraja_secret
DARAJA_BUSINESS_SHORTCODE=174379
DARAJA_PASSKEY=replace_daraja_passkey
DARAJA_CALLBACK_URL=https://ci.example.co.ke/billing/mpesa/callback

# Africa's Talking SMS API
AT_USERNAME=sandbox
AT_API_KEY=replace_at_api_key
AT_SENDER_ID=FORGE_CI

# GitHub Integration
GITHUB_TOKEN=replace_github_token
GITHUB_WEBHOOK_SECRET=replace_webhook_secret

